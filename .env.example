# Local development works without this file. Copy to .env to customize.
PORT=3000
APP_URL=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production. In development a local secret is generated in .data/.
BETTER_AUTH_SECRET=
# Leave empty for persistent embedded PostgreSQL in .data/postgres/.
# External PostgreSQL: postgresql://tutorflow:YOUR_PASSWORD@localhost:5432/tutorflow
DATABASE_URL=
PGLITE_DIR=.data/postgres
# Optional. No key = manual reports; no simulated AI responses.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_DAILY_LIMIT=20
# Optional transport encryption for external PostgreSQL. Does not disable verification.
DATABASE_SSL=false
# Optional loopback relay port. Requires DATABASE_SSL=true and a DNS host in DATABASE_URL.
DATABASE_RELAY_PORT=
# Optional Google Calendar connection. Use a Google OAuth Web client and a standalone 32-byte hex key.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_ENCRYPTION_KEY=
# Used only by the optional local compose.yaml. Choose your own password.
POSTGRES_PASSWORD=
