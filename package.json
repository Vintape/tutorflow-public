{
  "name": "tutorflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "start": "node dist/server/index.js --built",
    "build": "tsc --noEmit && vite build && tsup server/index.ts --format esm --platform node --target node22 --out-dir dist/server --external vite --external @electric-sql/pglite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:delete-account": "tsx scripts/delete-account.ts"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@electric-sql/pglite": "0.5.15",
    "@fontsource-variable/manrope": "5.3.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@tldraw/assets": "5.6.0",
    "@tldraw/state": "5.6.0",
    "@tldraw/store": "5.6.0",
    "@tldraw/sync": "5.6.0",
    "@tldraw/sync-core": "5.6.0",
    "@tldraw/tlschema": "5.6.0",
    "@tldraw/validate": "5.6.0",
    "better-auth": "1.7.18",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "express-rate-limit": "8.7.3",
    "helmet": "8.3.0",
    "katex": "0.19.1",
    "lucide-react": "1.70.0",
    "luxon": "3.7.2",
    "openai": "7.53.0",
    "pg": "8.23.1",
    "proper-lockfile": "4.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "sonner": "2.0.8",
    "tldraw": "5.6.0",
    "ws": "8.22.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/express": "5.0.6",
    "@types/katex": "0.16.7",
    "@types/luxon": "3.7.6",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@11.25.0"
}
